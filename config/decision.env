# System 1 (decision model) configuration.
#
# Copy the DECISION_* lines into .env.local and restart `next dev`.
# This is a tracked template for operators; it is not loaded automatically.
# JSON must stay on ONE LINE — dotenv does not join wrapped values.
#
# Four decision sites exist: quiz-verify, quiz-grade, exam-grading, claim-check.
# Each entry is independent. With no entry, the site has no decision model and
# the router calls the site's existing LLM baseline instead (fail-open).
#
# `fallback: "llm"` keeps that fail-open behaviour when the decision model is
# unavailable, abstains, times out, or returns an unusable answer. It is the
# default, but stated explicitly so the intent is unambiguous.
# `mode`: replace = use the decision answer; shadow = run both, keep the LLM
# answer and log agreement. Chat models cannot report calibrated confidence,
# so they default to replace and cannot use triage.
#
# The model string is resolved through the normal model registry, so it can be
# any provider:modelId pair available to this deployment.

DECISION_MODELS_ENABLED=true
DECISION_ROUTES={"quiz-verify":{"provider":"chat","model":"deepseek:deepseek-flash","mode":"replace","fallback":"llm","timeoutMs":15000,"maxInputChars":12000},"quiz-grade":{"provider":"chat","model":"deepseek:deepseek-flash","mode":"replace","fallback":"llm","timeoutMs":15000,"maxInputChars":12000},"exam-grading":{"provider":"chat","model":"deepseek:deepseek-flash","mode":"replace","fallback":"llm","timeoutMs":15000,"maxInputChars":12000},"claim-check":{"provider":"chat","model":"deepseek:deepseek-flash","mode":"replace","fallback":"llm","timeoutMs":15000,"maxInputChars":12000}}
