# Temporary opt-in: route OpenMAIC's LLM calls through your OpenCode account.
#
# This reconstructs the setup that was removed (it used OpenCode Zen's
# OpenAI-compatible endpoint via the `openrouter` provider, repointed at Zen).
# It is on the side branch `feat/opencode-hy4-flash` so `main` stays clean.
#
# HOW TO USE
#   1. Copy these NON-SECRET values into .env.local (gitignored).
#   2. Keep your existing OPENROUTER_API_KEY in .env.local -- that is your
#      OpenCode API key (https://opencode.ai/console/account#api-keys).
#      Do NOT commit it. If it has expired, mint a new one in that console.
#   3. Restart `next dev` (MODEL_ROUTES / provider config are read at boot).
#
# REVERT
#   Restore .env.local from .env.local.bak-pre-opencode (or .bak_kokoro) and
#   restart the dev server.

# OpenCode Go's OpenAI-compatible gateway (subscription plan, not the expired
# Zen pay-as-you-go key). The catalog at
#   https://opencode.ai/inference/go/v1/models
# lists `hy4-flash-free`. The `openrouter` provider here is used purely as an
# OpenAI-wire-protocol client; its key and base URL come from env.
# If you are on Zen instead of Go, use https://opencode.ai/zen/v1
OPENROUTER_BASE_URL=https://opencode.ai/inference/go/v1

# Model ids OpenCode exposes. First entry is the server-pinned default.
OPENROUTER_MODELS=hy4-flash-free,deepseek-v4-flash-free

# Route the course-generation stages to the OpenCode model. Interactive keeps
# thinking OFF: the free flash tier is fast but ignores token budgets, and a
# long scratchpad exhausts the validated-JSON output cap.
MODEL_ROUTES={"scene-outlines-stream":"openrouter:hy4-flash-free","scene-content":"openrouter:hy4-flash-free","scene-actions":"openrouter:hy4-flash-free","scene-content:interactive":{"model":"openrouter:hy4-flash-free","thinking":{"enabled":false}}}

DEFAULT_MODEL=openrouter:hy4-flash-free

# Optional fallback to the other free Zen model if hy4-flash-free is unavailable.
OPENMAIC_FALLBACK_MODEL=openrouter:deepseek-v4-flash-free
