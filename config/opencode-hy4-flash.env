# Temporary opt-in: route OpenMAIC's LLM calls through your OpenCode account.
#
# This reconstructs the setup that was removed (it used OpenCode Zen's
# OpenAI-compatible endpoint via the `openrouter` provider, repointed at Zen).
# It is on the side branch `feat/opencode-hy4-flash` so `main` stays clean.
#
# HOW TO USE
#   1. Copy these NON-SECRET values into .env.local (gitignored).
#   2. Paste a fresh OpenCode Console key (https://opencode.ai/console/account#api-keys)
#      into the dedicated, empty OPENCODE_API_KEY= entry in .env.local.
#      Do NOT commit it. Your existing OPENROUTER_API_KEY is left untouched and
#      is used only when the gateway is not opencode.ai.
#   3. Restart `next dev` (MODEL_ROUTES / provider config are read at boot).
#
# REVERT
#   Restore .env.local from .env.local.bak-pre-opencode (or .bak_kokoro) and
#   restart the dev server.

# Local o2api bridge -> your desktop OpenCode. Free models are capped on the
# Zen/Go HTTP APIs ("FreeUsageLimitError") but work through the desktop app,
# which is what this bridge uses.
#
# MODELS ARE DISCOVERED AT RUNTIME — do not pin a model id here.
# The app fetches the gateway's /v1/models and ranks the result: ids under
# OPENCODE_MODEL_PREFIX (default `opencode-go`) win, and a bare id that also
# exists under that prefix is dropped because it resolves to the wrong (Zen
# free) category -> 429. Leave OPENROUTER_MODELS, DEFAULT_MODEL and MODEL_ROUTES
# empty so the discovered default / your Settings choice can win.
# Set OPENCODE_MODEL_PREFIX only if the working category changes.
#
# Start the bridge (separate terminal, leave it running):
#   git clone --depth 1 https://github.com/Tandarke12345560/o2api.git %TEMP%\opencode\o2api
#   node %TEMP%\opencode\o2api\server.mjs --port 8787 --workdir %TEMP%\opencode\bridge-work
#
# IMPORTANT: launch the bridge with its PROCESS CWD outside the repo (cd to
# %TEMP%\opencode\bridge-work first). --workdir alone is not enough: the
# OpenCode agent still writes generated widget .html files into the node
# process's cwd, which would pollute the repository root.
# It reads ~/.config/opencode/service.json itself and needs no API key.
# The `openrouter` provider is used purely as an OpenAI-wire client here.
OPENROUTER_BASE_URL=http://127.0.0.1:8787/v1

# Empty = discover models from the gateway at runtime (cached 60s).
OPENROUTER_MODELS=
OPENCODE_MODEL_PREFIX=opencode-go

# No operator stage routes — a Settings choice or the discovered default wins.
MODEL_ROUTES={}

# Empty = fall back to the top-ranked discovered model.
DEFAULT_MODEL=

# No fallback: an invalid or rate-limited fallback id kills a run outright.
OPENMAIC_FALLBACK_MODEL=
